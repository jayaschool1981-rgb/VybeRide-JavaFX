<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.vyberide.controllers.DashboardController"
            prefHeight="300.0" prefWidth="400.0">

    <children>
        <VBox alignment="CENTER" spacing="15" prefWidth="400" prefHeight="300">
            <Label text="Welcome to Vybe Ride 🚗" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Button text="Logout" onAction="#handleLogout" style="-fx-background-color: #3B82F6; -fx-text-fill: white;"/>
        </VBox>
    </children>
</AnchorPane>
